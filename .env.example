# =============================================================================
# Palm Dataset Collection Platform — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in all required values.
# Never commit .env.local to source control.

# -----------------------------------------------------------------------------
# DATABASE (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
# Get from: https://app.supabase.com -> Settings -> Database -> Connection string
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# NEXTAUTH (Authentication)
# -----------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-32-chars-minimum"

# Admin user credentials (used in seed script)
ADMIN_EMAIL="admin@yourresearch.org"
# Generate a strong password for the admin account
ADMIN_PASSWORD="your-strong-admin-password"

# TOTP (Time-based One-Time Password) for 2FA
# Generate a base32 secret with: node -e "const { authenticator } = require('otplib'); console.log(authenticator.generateSecret());"
TOTP_SECRET="YOUR_BASE32_TOTP_SECRET"
# TOTP issuer label shown in authenticator app
TOTP_ISSUER="Palm Research Platform"

# -----------------------------------------------------------------------------
# AWS S3 (Image Storage)
# -----------------------------------------------------------------------------
# Create an IAM user with S3 permissions and generate access keys
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="palm-dataset-images"
# Optional: Custom endpoint for S3-compatible storage (e.g., Supabase Storage)
# S3_ENDPOINT_URL="https://[PROJECT_REF].supabase.co/storage/v1/s3"

# -----------------------------------------------------------------------------
# UPSTASH REDIS (Rate Limiting)
# -----------------------------------------------------------------------------
# Get from: https://console.upstash.com -> Create Database -> REST API
UPSTASH_REDIS_REST_URL="https://[DATABASE_NAME].upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# -----------------------------------------------------------------------------
# EMAIL (Resend — Optional)
# -----------------------------------------------------------------------------
# Get from: https://resend.com -> API Keys
# If not set, email confirmation will be skipped
RESEND_API_KEY="re_your_resend_api_key"
# The "from" address for confirmation emails (must be verified in Resend)
RESEND_FROM_EMAIL="noreply@yourresearch.org"
# Research contact for withdrawal requests
RESEARCH_CONTACT_EMAIL="research@yourresearch.org"

# -----------------------------------------------------------------------------
# PUBLIC VARIABLES (exposed to browser)
# -----------------------------------------------------------------------------
# Maximum file size for uploads in MB
NEXT_PUBLIC_MAX_FILE_SIZE_MB="10"
# Application URL (used for generating reference links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
